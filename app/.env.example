# Copy to .env and load in your platform's secret store. Never commit real values.
MODE=prototype                      # prototype | live   (prototype cannot write to storage)
FORM_PURPOSE=brand_enquiries        # only brand_enquiries is implemented; others fail closed
PORT=3000
DATA_DIR=./data                     # persistent volume in production; see README on moving off disk

# Required when MODE=live. The app refuses to start without these, so it cannot come up open.
OWNER_USER=
OWNER_PASS=                         # min 12 chars, checked at startup
TRUST_PROXY=false                   # only true behind a proxy that sets X-Forwarded-For

# Request caps. Defaults shown; raising MAX_FILE_BYTES needs care because files are buffered in memory.
MAX_FIELDS=30
MAX_FIELD_BYTES=32768
MAX_FILES=5
MAX_FILE_BYTES=26214400
MAX_REQUEST_BYTES=104857600

# ---- model wiring. All of it off by default: with MODEL_PROVIDER empty there is no endpoint to reach.
# Adding a vendor = one adapter file + one line in src/model/providers/registry.js.
MODEL_PROVIDER=                       # none | echo | openai | openai-compatible | ollama
MODEL_ENABLED=false
MODEL_BASE_URL=                       # openai/ollama have a vendor default; openai-compatible needs you to name it
MODEL_ID=                             # e.g. gpt-4o-mini / llama3, per provider
MODEL_API_KEY=                        # live only. never in a file you commit, never in the browser
MODEL_TEMPERATURE=0.2
MODEL_MAX_OUTPUT_TOKENS=1200
MODEL_TIMEOUT_MS=30000
MODEL_MAX_CALLS_PER_BRIEF=2           # research + script; a loop cannot spend more than this

# The two approvals. Both are needed because they authorise different things, and both are refused
# unless MODE=live, MODEL_ENABLED=true and MODEL_DRY_RUN=false line up behind them.
MODEL_SEND_BRIEF_DATA=false           # lets the enquiry text leave this machine toward MODEL_BASE_URL
OCR_IMAGE_APPROVED=false              # lets an uploaded brand asset leave this machine

MODEL_DRY_RUN=true                    # assemble the prompt, report its size, contact nothing
PROMPTS_DIR=prompts                   # edit *.prompt.md freely; nothing is hard-coded
